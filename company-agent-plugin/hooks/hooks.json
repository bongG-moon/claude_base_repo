{
  "description": "Routes each prompt to a model tier and enforces Company Agent policy, activity capture, and completion feedback.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/Invoke-CompanyAgent.ps1", "-Mode", "Hook", "-Event", "SessionStart"],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/Invoke-CompanyAgent.ps1",
              "-Mode", "Hook", "-Event", "UserPromptSubmit"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:mcp__corp-db-read__.*|mcp__corp-outlook-self__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/Invoke-CompanyAgent.ps1",
              "-Mode", "Hook", "-Event", "PreToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/Invoke-CompanyAgent.ps1",
              "-Mode", "Hook", "-Event", "PostToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?:Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/Invoke-CompanyAgent.ps1",
              "-Mode", "Hook", "-Event", "PostToolUseFailure"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/Invoke-CompanyAgent.ps1",
              "-Mode", "Hook", "-Event", "Stop"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
